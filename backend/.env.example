PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# sqlite (local, no Docker) | postgres (docker compose up -d)
DATABASE_TYPE=sqlite
SQLITE_PATH=shopflow.dev.sqlite

# Postgres (when DATABASE_TYPE=postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=shopflow
DATABASE_PASSWORD=shopflow
DATABASE_NAME=shopflow

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
PLATFORM_SECRET=change-me-in-production-use-a-long-random-string

# Dev seed
SEED_ON_BOOT=true

# Cloudflare edge provisioning (optional in local development)
# CLOUDFLARE_EDGE_ADMIN_URL=http://localhost:8787/api/admin/tenants
# CLOUDFLARE_EDGE_ADMIN_KEY=

# Public application URLs
API_PUBLIC_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Mail provider (optional locally; required for email features)
SENDBYTE_API_KEY=replace-with-local-or-test-provider-key
SENDBYTE_API_URL=https://api.sendbyte.io
SENDBYTE_FROM_EMAIL=no-reply@example.test
SENDBYTE_FROM_NAME=Kunemi Workspace

# Cloudflare R2 storage (optional; local storage is used when unset)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kunemi-media
# R2_PUBLIC_URL=
