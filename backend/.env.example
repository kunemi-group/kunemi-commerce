PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# sqlite (local, no Docker) | postgres (docker compose up -d)
DATABASE_TYPE=sqlite
SQLITE_PATH=shopflow.dev.sqlite

# Postgres (when DATABASE_TYPE=postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=shopflow
DATABASE_PASSWORD=shopflow
DATABASE_NAME=shopflow

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Dev seed
SEED_ON_BOOT=true
